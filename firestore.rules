rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function areFriends(uid1, uid2) {
      let id = uid1 < uid2 ? uid1 + "_" + uid2 : uid2 + "_" + uid1;
      return exists(/databases/$(database)/documents/friendships/$(id)) && 
             get(/databases/$(database)/documents/friendships/$(id)).data.status == 'accepted';
    }

    // Characters rules
    match /characters/{characterId} {
      function canReadCharacter(data) {
        return data.userId == request.auth.uid || areFriends(data.userId, request.auth.uid);
      }

      allow list: if isSignedIn() && canReadCharacter(resource.data);
      allow get: if isSignedIn() && (resource == null || canReadCharacter(resource.data));
      
      function isValidCharacter(data) {
        return data.userId == request.auth.uid &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 64 &&
               data.faction in ["Norrath's Keeper", "Norrath's Keepers", "Dark Reign"] &&
               data.reputation is string &&
               data.reputationValue is number &&
               data.reputationValue >= -2000 && data.reputationValue <= 2000 &&
               data.completedTasks is list &&
               (!('hasStartedDoN' in data) || data.hasStartedDoN is bool);
      }

      allow create: if isSignedIn() && 
                      isValidCharacter(request.resource.data) &&
                      request.resource.data.keys().hasAll(['userId', 'name', 'faction', 'reputation', 'reputationValue', 'completedTasks', 'createdAt', 'updatedAt']) &&
                      (request.resource.data.keys().size() >= 8 && request.resource.data.keys().size() <= 11) &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time;
      
      allow update: if isSignedIn() && isOwner(resource.data.userId) &&
                      request.resource.data.userId == resource.data.userId &&
                      (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
                      request.resource.data.updatedAt == request.time;
      
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    // User profile rules
    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isSignedIn(); // Simplified list for search queries
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == userId;
    }

    // Friendship rules
    match /friendships/{friendshipId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.uids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.uids;
      allow create: if isSignedIn() && 
                      request.resource.data.requesterId == request.auth.uid &&
                      request.resource.data.status == 'pending' &&
                      request.resource.data.uids.size() == 2 &&
                      request.auth.uid in request.resource.data.uids &&
                      isValidId(request.resource.data.receiverId);
      allow update: if isSignedIn() && 
                      request.auth.uid in resource.data.uids &&
                      (
                        // Receiver accepts
                        (request.auth.uid == resource.data.receiverId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'accepted') ||
                        // Action: Update Nickname
                        (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nicknames']) &&
                          request.resource.data.nicknames.diff(resource.data.get('nicknames', {})).affectedKeys().hasOnly([request.auth.uid]) &&
                          request.resource.data.nicknames[request.auth.uid] is string &&
                          request.resource.data.nicknames[request.auth.uid].size() <= 32
                        )
                      );
      allow delete: if isSignedIn() && request.auth.uid in resource.data.uids;
    }
  }
}
